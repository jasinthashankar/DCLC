# ==============================================================================
# DCLC Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR API KEYS TO VERSION CONTROL.
# Copy this file to .env and insert your real credentials locally.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Pipeline Options
# ------------------------------------------------------------------------------
DCLC_MAX_UPLOAD_BYTES=52428800
DCLC_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DCLC_CHECKPOINT_PATH=checkpoints/dclc_encoder_version_aware.pt
DCLC_DEVICE=cpu

# ------------------------------------------------------------------------------
# 2. RAG Generation Provider Selection
# Options: "mock", "groq", or "local"
# Default: "mock" (safe offline testing without external dependencies)
# ------------------------------------------------------------------------------
DCLC_RAG_PROVIDER=mock

# ------------------------------------------------------------------------------
# 3. Groq Cloud API Settings (Required only if DCLC_RAG_PROVIDER=groq)
# NOTE: Using Groq transmits retrieved evidence chunks to Groq Cloud servers.
# Obtain a free API key from: https://console.groq.com/keys
# ------------------------------------------------------------------------------
DCLC_GROQ_API_KEY=gsk_your_groq_api_key_placeholder_here
DCLC_GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. Local OpenAI-Compatible Server Settings (Required only if DCLC_RAG_PROVIDER=local)
# Examples: Ollama (http://localhost:11434/v1), vLLM, or llama.cpp server.
# Zero data leaves the local machine.
# ------------------------------------------------------------------------------
DCLC_LOCAL_BASE_URL=http://localhost:11434/v1
DCLC_LOCAL_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# 5. RAG Retrieval & Safety Defaults
# ------------------------------------------------------------------------------
DCLC_RAG_DEFAULT_TOP_K=5
DCLC_RAG_DEFAULT_ALPHA=0.5
DCLC_RAG_STRICT_VERSION_ISOLATION=true
